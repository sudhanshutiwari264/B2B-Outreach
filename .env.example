# --- Database ---
DATABASE_URL=postgresql+asyncpg://outreach:outreach@localhost:5432/outreach
DATABASE_URL_SYNC=postgresql+psycopg://outreach:outreach@localhost:5432/outreach

# --- Tavily (web research) ---
TAVILY_API_KEY=

# --- Tarqa AI (LLM provider) ---
# TARQA_BASE_URL is the gateway root (the app appends /v1 itself); it exposes an
# OpenAI-compatible /v1/chat/completions and /v1/models. Run GET /health/integrations
# after setting these, or call TarqaClient.list_models(), to see which TARQA_MODEL
# identifiers your account actually has access to - do not guess a model name.
TARQA_API_KEY=
TARQA_BASE_URL=https://api.tarqaai.com/api
TARQA_MODEL=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
# Comma-separated list of allowed frontend origins (CORS). Add your Vercel URL(s) in
# production, e.g. https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Resilience / limits ---
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
MAX_CONTENT_BYTES=2000000
MAX_CONCURRENT_EXTRACTIONS=5
